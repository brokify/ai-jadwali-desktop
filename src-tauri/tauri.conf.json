{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Jadwali Desktop",
  "version": "1.0.0",
  "identifier": "com.aijadwali.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "جدولي — AI Jadwali Desktop",
        "width": 1280,
        "height": 820,
        "minWidth": 920,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "AI Jadwali Desktop",
    "copyright": "Copyright © 2026 AI Jadwali Desktop contributors",
    "category": "Education",
    "shortDescription": "Local-first Arabic school timetable management",
    "longDescription": "Create, validate, publish, report, export, and back up Arabic school timetables entirely on the local device.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "compression": "lzma",
        "startMenuFolder": "AI Jadwali Desktop"
      }
    }
  }
}
